<Window x:Class="ObjectViewer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Settings" Height="300" Width="400"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Background:" Width="100" VerticalAlignment="Center" />
            <xctk:ColorPicker x:Name="BackgroundColorPicker" Width="150" SelectedColorChanged="ColorPicker_SelectedColorChanged" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Grid" Width="100" VerticalAlignment="Center" />
            <xctk:ColorPicker x:Name="GridColorPicker" Width="150" SelectedColorChanged="ColorPicker_SelectedColorChanged" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Model:" Width="100" VerticalAlignment="Center" />
            <xctk:ColorPicker x:Name="ModelColorPicker" Width="150" SelectedColorChanged="ColorPicker_SelectedColorChanged" />
        </StackPanel>
        
        <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Render Type:" Width="100" VerticalAlignment="Center" />
            <ComboBox x:Name="RenderTypeComboBox" Width="150" SelectedIndex="0">
            </ComboBox>
        </StackPanel>

        <Button Grid.Row="3" Content="Apply" HorizontalAlignment="Right" Width="100" Height="30" Click="ApplyButton_Click" />
    </Grid>
</Window>